{
  "manifest_version": 3,
  "name": "Twitch Hide Streamer",
  "version": "1.0",
  "description": "Hides selected streamers on Twitch",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["content.js"],
      "css": ["twitch-styles.css"]
    }
  ]
}